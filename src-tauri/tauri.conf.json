{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivet",
  "version": "0.2.3",
  "identifier": "com.rivet.serial",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Rivet",
      "width": 1064,
      "height": 640,
      "minWidth": 1064,
      "minHeight": 640,
      "center": true,
      "decorations": false,
      "transparent": true,
      "shadow": false
    }],
    "macOSPrivateApi": true,
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../THIRD_PARTY_NOTICES.md",
      "../licenses/MPL-2.0.txt",
      "../licenses/Unicode-3.0.txt",
      "../licenses/MIT-LXGW-Webfont.txt",
      "../licenses/OFL-1.1-LXGW.txt",
      "../licenses/OFL-1.1-JetBrains.txt"
    ]
  }
}
